diff --git a/cmake/modules/configuration_files.cmake b/cmake/modules/configuration_files.cmake
index e7b553ce8e7..5710d7a64a4 100644
--- a/cmake/modules/configuration_files.cmake
+++ b/cmake/modules/configuration_files.cmake
@@ -99,6 +99,22 @@ zephyr_boilerplate_watch(DTC_OVERLAY_FILE)
 
 zephyr_get(EXTRA_CONF_FILE SYSBUILD LOCAL VAR EXTRA_CONF_FILE OVERLAY_CONFIG MERGE REVERSE)
 zephyr_get(EXTRA_DTC_OVERLAY_FILE SYSBUILD LOCAL MERGE REVERSE)
+
+# Keep the simulator's hardware map when a test supplies its own overlay.
+# Twister passes test overlays through DTC_OVERLAY_FILE, replacing the command
+# line EXTRA_DTC_OVERLAY_FILE value used by this comparison campaign. Append
+# the engine-specific board overlay after Zephyr merges both sources.
+if(BOARD_DIR MATCHES "/boards/local/rv32_compare$" AND
+   COMPARE_ENGINE MATCHES "^(qemu|rv32emu)$")
+  set(compare_engine_overlay "${BOARD_DIR}/${COMPARE_ENGINE}.overlay")
+  if(EXISTS "${compare_engine_overlay}")
+    list(FIND EXTRA_DTC_OVERLAY_FILE "${compare_engine_overlay}" compare_engine_overlay_index)
+    if(compare_engine_overlay_index EQUAL -1)
+      list(APPEND EXTRA_DTC_OVERLAY_FILE "${compare_engine_overlay}")
+    endif()
+  endif()
+endif()
+
 zephyr_get(DTS_EXTRA_CPPFLAGS SYSBUILD LOCAL MERGE REVERSE)
 build_info(application source-dir VALUE ${APPLICATION_SOURCE_DIR})
 build_info(application configuration-dir VALUE ${APPLICATION_CONFIG_DIR})
