FROM ubuntu:24.04 AS base
ARG TARGETARCH
ARG SAIL_VERSION=0.16
# Release asset digests for SAIL_VERSION; update them together, and keep
# them in step with .ci/arch-test-setup.sh.
ARG SAIL_SHA256_X86_64=f9bb8a32b8f3eddbdf69b3a29d96dff4ba1e77f45877165e0478418367da6bee
ARG SAIL_SHA256_AARCH64=92163c1b02b416ae6a031283e0b2085674daed5dfa2d79b1c929ef23da51da73
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
RUN case "$TARGETARCH" in \
        amd64) sail_arch=x86_64 sail_sha256=$SAIL_SHA256_X86_64 ;; \
        arm64) sail_arch=aarch64 sail_sha256=$SAIL_SHA256_AARCH64 ;; \
        *) exit 1 ;; \
    esac && \
    curl --fail --location --retry 3 \
        "https://github.com/riscv/sail-riscv/releases/download/${SAIL_VERSION}/sail-riscv-Linux-${sail_arch}.tar.gz" \
        -o /tmp/sail.tar.gz && \
    echo "$sail_sha256  /tmp/sail.tar.gz" | sha256sum -c - && \
    mkdir /sail && tar -xzf /tmp/sail.tar.gz --strip-components=1 -C /sail && \
    test "$(/sail/bin/sail_riscv_sim --version)" = "$SAIL_VERSION"

FROM ubuntu:24.04 AS final
COPY --from=base /sail/ /opt/sail-riscv/
ENV PATH="/opt/sail-riscv/bin:${PATH}"
