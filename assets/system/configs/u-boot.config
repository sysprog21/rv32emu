CONFIG_RISCV=y
CONFIG_TEXT_BASE=0x00000000
CONFIG_SYS_MALLOC_LEN=0x800000
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x00400000
CONFIG_ENV_SIZE=0x20000
CONFIG_DEFAULT_DEVICE_TREE="qemu-virt32"
CONFIG_SYS_MONITOR_LEN=786432
CONFIG_SYS_LOAD_ADDR=0x00400000
# CONFIG_PCI is not set
CONFIG_TARGET_QEMU_VIRT=y
CONFIG_RISCV_SMODE=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_F is not set
CONFIG_RELOC_ADDR_TOP=y
# CONFIG_EFI_LOADER is not set
CONFIG_DISTRO_DEFAULTS=y
CONFIG_BOOTDELAY=1
CONFIG_BOOTCOMMAND="if ext4load virtio 0 0x00400000 /Image; then booti 0x00400000 - $fdtcontroladdr; fi"
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv bootm_low 0; virtio scan"
CONFIG_CONSOLE_RECORD=y
# CONFIG_PRE_CONSOLE_BUFFER is not set
CONFIG_SYS_STDIO_DEREGISTER=y
CONFIG_DISPLAY_CPUINFO=y
CONFIG_DISPLAY_BOARDINFO=y
CONFIG_CYCLIC=y
# CONFIG_BOARD_INIT is not set
CONFIG_LAST_STAGE_INIT=y
# CONFIG_CMD_MII is not set
CONFIG_CMD_CLS=y
CONFIG_ENV_RELOC_GD_ENV_ADDR=y
# CONFIG_MTD is not set
CONFIG_NVME=y
# CONFIG_RNG_RISCV_ZKR is not set
# CONFIG_USB is not set
# CONFIG_VIDEO is not set
CONFIG_FAT_WRITE=y
CONFIG_FAT_RENAME=y
CONFIG_HEXDUMP=y
# CONFIG_TOOLS_LIBCRYPTO is not set
